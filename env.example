NODE_ENV=development
PORT=3001
KEYFORT_IMAGE=ghcr.io/alterem/keyfort:latest
KEYFORT_PORT=3001
KEYFORT_VOLUME=keyfort-data
# Optional when the frontend is hosted on a different origin from the API.
FRONTEND_ORIGIN=
# Set to true only when a reverse proxy terminates HTTPS in front of KeyFort.
# Leave unset for plain-HTTP deployments, otherwise the CSP
# upgrade-insecure-requests directive breaks asset loading.
FORCE_HTTPS=
# Generate a 32-byte key: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# Optional server-side seed for the first team vault.
DEFAULT_TOTP_SECRET=
